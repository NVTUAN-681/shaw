import pygame
from pygame.locals import *
import button
fpsclock = pygame.time.Clock()
FPS = 30

pygame.init()

WINDOWWIDTH = 400
WINDOWHEIGHT = 400
LEFT_ADD = 100
DOWN_ADD = 100
tile_size = 15
tile_type = 4
row = 66
col = 61
scroll_x = 0
scroll_y = 0
tile_count = 0

dir = "moew/"

img1 = pygame.transform.scale(pygame.image.load("bg1.jpg"),(WINDOWWIDTH , WINDOWHEIGHT ))
screen = pygame.display.set_mode((WINDOWWIDTH + LEFT_ADD, WINDOWHEIGHT + DOWN_ADD))
pygame.display.set_caption("hehe")


img_list = []
for i in range(tile_type):
    img = pygame.image.load(f'{dir}{i}.png')
    img = pygame.transform.scale(img,(tile_size,tile_size))
    img_list.append(img)
def draw_grid():
    for i in range(col + 1):
        pygame.draw.line(screen,( 250,250,250), (i* tile_size - scroll_x, -scroll_y), (i * tile_size - scroll_x, WINDOWHEIGHT - scroll_y))
    for i in range(row +1 ):
        pygame.draw.line(screen,(250,250,250), (-scroll_x, i * tile_size - scroll_y), (WINDOWWIDTH - scroll_x, WINDOWHEIGHT - scroll_y)) # Sửa WINDOWWIDTH thành WINDOWHEIGHT nếu muốn kéo dài hết chiều cao
def draw_bg():
    pygame.draw.rect(screen,(0,0,0),(0,0,WINDOWWIDTH + LEFT_ADD,WINDOWHEIGHT + DOWN_ADD))
    screen.blit(img1,(-scroll_x, -scroll_y))



button_list = []
button_col = 0
button_row = 0
for i in range(len(img_list)):
    tile_button = button.Button(WINDOWWIDTH + (tile_size*2 * button_col) + tile_size, (tile_size*2 * button_row) + tile_size, img_list[i], 1)
    button_list.append(tile_button)
    button_col += 1
    if button_col == 3:
        button_row += 1
        button_col = 0

def move():
    dx = 0
    dy = 0
    global scroll_x, scroll_y
    speed = 5
    if left:
        dx -= speed
    if right:
        dx += speed
    if up :
        dy -= speed
    if down:
        dy += speed
    scroll_x += dx
    scroll_y += dy
right ,left , up , down= False, False , False ,  False
run = True
while run:
    move()
    draw_bg()
    draw_grid()

    button_count = 0
    for button_count, i in enumerate(button_list):
        if i.draw(screen):
            tile_count = button_count
    print(tile_count)


    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            run = False
        if event.type == KEYDOWN:
            if event.key == K_SPACE:
                run = False
            if event.key == K_LEFT:
                left = True
            if event.key == K_RIGHT:
                right = True
            if event.key == K_UP:
                up = True
            if event.key == K_DOWN:
                down = True
        if event.type == KEYUP:
            if event.key == K_LEFT:
                left = False
            if event.key == K_RIGHT:
                right = False
            if event.key == K_UP:
                up = False
            if event.key == K_DOWN:
                down = False

    pygame.display.update()
    fpsclock.tick(FPS)

pygame.quit()